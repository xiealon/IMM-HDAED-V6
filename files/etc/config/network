config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option packet_steering '1'
	# 主路由：若上游下发 PD，LAN 会用 PD 前缀；这个 ULA 只是拿不到 PD 时的兜底
	option ula_prefix 'fd80:e247:db6e::/48'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '64'
	option delegate '0'

# 【主路由】WAN：接光猫 LAN 口走 DHCP；若是 PPPoE 拨号，把 proto 改成 pppoe 并填 username/password
config interface 'wan'
	option proto 'dhcp'

# 【主路由】WAN6：向运营商/上游要地址与前缀（PD），LAN 的 /64 从中分配
config interface 'wan6'
	option device '@wan'
	option proto 'dhcpv6'
	option reqaddress 'try'
	option reqprefix 'auto'
	option norelease '1'

config interface 'vpn0'
	option proto 'none'
	option device 'tun0'

config device 'br_lan'
	option type 'bridge'
	option name 'br-lan'
	list ports 'eth0'

config device 'lxcbr0'
	option name 'lxcbr0'
	option type 'bridge'
	option bridge_empty '1'

config interface 'lxc'
	option proto 'static'
	option device 'lxcbr0'
	option ipaddr '10.1.0.1'
	option netmask '255.255.255.0'

config interface 'docker'
	option device 'docker0'
	option proto 'none'
	option auto '0'

config device
	option type 'bridge'
	option name 'docker0'
